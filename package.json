{
  "name": "bango",
  "private": true,
  "version": "1.0.21",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "type-check": "vue-tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:rust": "source \"$HOME/.cargo/env\" 2>/dev/null; cd src-tauri && cargo clippy -- -D warnings",
    "format:rust": "source \"$HOME/.cargo/env\" 2>/dev/null; cd src-tauri && cargo fmt --check",
    "check:all": "npm run type-check && npm run lint:check && npm run format:check && npm run format:rust && npm run lint:rust",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "simple-git-hooks || true",
    "tauri:windows:build": "tauri-windows-bundle build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "marked": "^18.0.4",
    "pinia": "^3.0.4",
    "vue": "^3.5.33",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@choochmeque/tauri-windows-bundle": "^0.1.18",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.2.4",
    "@tauri-apps/cli": "^2.11.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/test-utils": "^2.4.10",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.0",
    "globals": "^17.6.0",
    "happy-dom": "^20.9.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^4.2.4",
    "tslint": "^5.20.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "vite": "^8.0.10",
    "vitest": "^4.1.5",
    "vue-tsc": "^3.2.7"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,html}": [
      "prettier --write"
    ]
  }
}
