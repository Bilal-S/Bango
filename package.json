{
  "name": "bango",
  "private": true,
  "version": "3.2.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "type-check": "vue-tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:rust": "source \"$HOME/.cargo/env\" 2>/dev/null; cd src-tauri && cargo clippy -- -D warnings",
    "format:rust": "source \"$HOME/.cargo/env\" 2>/dev/null; cd src-tauri && cargo fmt --check",
    "check:all": "npm run type-check && npm run lint:check && npm run format:check && npm run format:rust && npm run lint:rust && npm run test && npm run check:test-inventory && npm run check:slow-manifest",
    "test": "vitest run",
    "test:rust": "bash scripts/rust-test.sh",
    "test:rust:full": "bash scripts/rust-test.sh --full",
    "test:rust:changed": "bash scripts/rust-test.sh --changed",
    "test:rust:live": "bash scripts/rust-test.sh --live",
    "check:test-inventory": "bash scripts/check-test-inventory.sh",
    "check:slow-manifest": "bash scripts/check-slow-manifest.sh",
    "test:coverage": "vitest run --coverage",
    "coverage:rust": "source \"$HOME/.cargo/env\" 2>/dev/null; cd src-tauri && cargo llvm-cov --fail-under-lines 70",
    "clean:rust": "cd src-tauri && cargo clean",
    "sweep:rust": "cd src-tauri && cargo sweep -t 14",
    "test:watch": "vitest",
    "postinstall": "simple-git-hooks || true",
    "tauri:windows:build": "tauri-windows-bundle build"
  },
  "dependencies": {
    "@sigma/export-image": "^3.0.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "apexcharts": "^5.16.0",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "graphology-gexf": "^0.13.2",
    "graphology-layout-forceatlas2": "^0.10.1",
    "graphology-types": "^0.24.8",
    "marked": "^18.0.12",
    "pinia": "^3.0.4",
    "sigma": "^3.0.3",
    "vue": "^3.5.42",
    "vue-router": "^4.6.4",
    "vue3-apexcharts": "^1.11.1"
  },
  "devDependencies": {
    "@choochmeque/tauri-windows-bundle": "^0.1.29",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/test-utils": "^2.5.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.0",
    "fallow": "^2.104.0",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,html}": [
      "prettier --write"
    ]
  }
}
