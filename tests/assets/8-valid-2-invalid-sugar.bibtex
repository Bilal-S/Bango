@article{11832971420160901,
 abstract  = "In 2012 Noga Conservation was appointed to carry out a condition survey and treatment of two very large scale maps in the Map Room of the Churchill War Rooms. After the condition of the maps was assessed, the paper conservators began tests on the maps prior to treatment. Two main conservation issues were established: first, the need to stabilise and consolidate the powdery and fragile areas which had been pierced by pins during the room’s wartime use; and second, the removal of the thick layer of dirt extant to the lower border area. Further complicating the project was the fact that the conservation had to be carried outin situwhile the museum remained open. After localised tests were carried out, funori was chosen as both the main cleaning agent and consolidant for the project. Funori was non-toxic and easy to use in the cramped conditions of the War Rooms, effective at stain reduction, and quick to penetrate the ingrained layers of dirt to consolidate the maps without staining or v",
 author    = "Harrold, Jillian and Schmuecker, Emma and Wyszomirska-Noga, Zofia",
 number    = "2",
 title     = "The treatment of two WWII maps from the Map Room in the Churchill War Rooms.",
 volume    = "39",
 url       = "https://research.ebsco.com/plink/d5acca51-9844-3ed8-bb08-129e163493cd",
 year      = "2016",
 issn      = "1945-5224",
 journal   = "Journal of the Institute of Conservation",
 keywords  = "Preservation of maps; World War II; Maps",
 pages     = "133-144",
 note      = "",
}

@article{15449310220211201,
 abstract  = "Purpose To investigate the governance of the Japanese Midwives Association and the challenges it faced based on reviews of agendas proposed at its annual meetings. Methods Literature review of the Bulletin of Annual Meetings of the Japanese Midwives Association (between 1929 and 1943) and other midwifery journals. Results A nation-wide organization of midwives in Japan was founded in 1927 with a view to consolidate the scope of their work and to raise their status. An annual meeting of the Japanese Midwives Association was held in a different prefecture each year hosted by the head of that prefectural association who took over the Association's presidency for one year until the next meeting. In more than half of the prefectures a male medical doctor was the head of the prefectural Midwives Association. A review of bulletins of annual meetings of the Japanese Midwives Association revealed three major points. One is that midwives in the prewar period were eager to establish midwifery by",
 author    = "Etsuko MATSUOKA",
 number    = "2",
 title     = "A study on the governance of the Japanese Midwives Association and the challenges it faced in the pre-WWII Period: based on reviews of agendas proposed at the annual meetings of the Japanese Midwives Association.",
 volume    = "35",
 url       = "https://research.ebsco.com/plink/0744a804-bf8a-3c28-a89e-559506b39fad",
 year      = "2021",
 issn      = "0917-6357",
 journal   = "Journal of Japan Academy of Midwifery",
 keywords  = "Midwives Organizations; Clinical Governance; War; Midwives Psychosocial Factors; Japan; Social Welfare",
 pages     = "101-112",
 note      = "",
}

